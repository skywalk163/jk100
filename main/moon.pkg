import {
  "moonbitlang/core/builtin",
  "jk100/jk100/lib/platform",
}

supported_targets = "native"

options(
  "is-main": true,
  "link": {
    "native": {
      "cc-flags": "-I../lib/platform -I../lib/ui -I./",
      "cc-link-flags": "-Xlinker -subsystem:console -lkernel32 -luser32 -ladvapi32 -lpsapi -lole32 -lshell32"
    }
  },
  "native-stub": [ "stubs.c" ],
)
