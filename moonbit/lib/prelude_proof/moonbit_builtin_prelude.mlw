module Byte
  use mach.int.Byte as WByte
  use Int as MoonBitInt

  let function to_int (b: WByte.byte) : MoonBitInt.t = MoonBitInt.of_int (WByte.to_int b)
end

module Bytes
  use int.Int
  use seq.Seq
  use mach.int.Byte
  use Int as MoonBitInt

  type bytes

  val function model (b: bytes) : seq byte

  val function length (b: bytes) : MoonBitInt.t
    ensures { MoonBitInt.model result = Seq.length (model b) }

  val function get (b: bytes) (i: MoonBitInt.t) : byte
    requires { 0 <= MoonBitInt.model i < MoonBitInt.model (length b) }
    ensures  { result = Seq.get (model b) (MoonBitInt.model i) }
end

module FixedArray
  use int.Int
  use array.Array
  use Int as MoonBitInt

  val function length (a: array 'a) : MoonBitInt.t
    ensures { MoonBitInt.model result = Array.length a }

  function get (a: array 'a) (i: MoonBitInt.t) : 'a =
    Array.([]) a (MoonBitInt.model i)

  val function make (n: MoonBitInt.t) (v: 'a) : array 'a
    ensures { 0 <= MoonBitInt.model n ->
      MoonBitInt.model (length result) = MoonBitInt.model n }
    ensures { forall i : MoonBitInt.t.
      0 <= MoonBitInt.model i < MoonBitInt.model n -> get result i = v }

  val function make_checked (n: MoonBitInt.t) (v: 'a) : array 'a
    requires { [@expl:array creation size] 0 <= MoonBitInt.model n }
    ensures { result = make n v }
    ensures { MoonBitInt.model (length result) = MoonBitInt.model n }
    ensures { forall i : MoonBitInt.t.
      0 <= MoonBitInt.model i < MoonBitInt.model n -> get result i = v }

  val get_checked (a: array 'a) (i: MoonBitInt.t) : 'a
    requires { [@expl:index in array bounds]
      0 <= MoonBitInt.model i < MoonBitInt.model (length a) }
    ensures  { result = get a i }

  val set_checked (a: array 'a) (i: MoonBitInt.t) (v: 'a) : unit writes { a }
    requires { [@expl:index in array bounds]
      0 <= MoonBitInt.model i < MoonBitInt.model (length a) }
    ensures  { a = (old a)[MoonBitInt.model i <- v] }
    ensures  { get a i = v }
    ensures  { MoonBitInt.model (length a) = MoonBitInt.model (length (old a)) }
    ensures  { forall j : MoonBitInt.t [get a j].
      0 <= MoonBitInt.model j < MoonBitInt.model (length a) ->
      MoonBitInt.model j <> MoonBitInt.model i ->
      get a j = get (old a) j }
end

module BytesView
  use int.Int
  use seq.Seq
  use mach.int.Byte
  use Int as MoonBitInt

  val function length (v: seq byte) : MoonBitInt.t
    ensures { MoonBitInt.model result = Seq.length v }

  function get (v: seq byte) (i: MoonBitInt.t) : byte =
    Seq.get v (MoonBitInt.model i)

  val function get_checked (v: seq byte) (i: MoonBitInt.t) : byte
    requires { 0 <= MoonBitInt.model i < MoonBitInt.model (length v) }
    ensures  { result = get v i }
end

module ReadOnlyArray
  use int.Int
  use seq.Seq
  use Int as MoonBitInt

  type readonlyarray 'a

  (* `model` is logic-only: recursive SCC shielding reasons through the sequence
     model in specs, but program code must not call it directly. *)
  function model (xs: readonlyarray 'a) : seq 'a

  (* `empty` is a pure observer-facing constructor for readonly-array literals
     in verified program code. Non-shielded lowering may still optimize it to
     `Seq.empty`, but shielded recursive uses need an abstract symbol of the
     wrapper type. *)
  val constant empty : readonlyarray 'a

  (* `length`/`get` are `val function`s rather than plain logical functions so
     shielded readonly-array observers remain usable from non-ghost WhyML code
     after cloning. *)
  val function length (xs: readonlyarray 'a) : MoonBitInt.t

  val function get (xs: readonlyarray 'a) (i: MoonBitInt.t) : 'a

  axiom length_model:
    forall xs : readonlyarray 'a.
      MoonBitInt.model (length xs) = Seq.length (model xs)

  axiom empty_model:
    model (empty : readonlyarray 'a) = (Seq.empty : seq 'a)

  axiom empty_length:
    MoonBitInt.model (length (empty : readonlyarray 'a)) = 0

  axiom get_model:
    forall xs : readonlyarray 'a, i : MoonBitInt.t.
      0 <= MoonBitInt.model i < MoonBitInt.model (length xs) ->
      get xs i = Seq.get (model xs) (MoonBitInt.model i)
end
