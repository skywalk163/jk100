(* Math-integer proof prelude.

   This file intentionally provides the same Why3 module surface as the
   machine-integer prelude, but interprets MoonBit machine integer families as
   unbounded mathematical integers. Build systems should put exactly one
   moonbit_builtin_prelude.mlw provider on the Why3 loadpath. *)

module Int
  use int.Int
  use int.ComputerDivision as ComputerDivision

  type t = int

  let constant min_value_model : int = -0x8000_0000
  let constant max_value_model : int = 0x7fff_ffff

  predicate in_bounds (_n: int) = true

  function model (x: t) : int = x

  val model (x: t) : int
    ensures { result = model x }

  lemma model_in_bounds:
    forall x: t. in_bounds (model x)

  lemma extensionality:
    forall x y: t. model x = model y -> x = y

  function of_int (n: int) : t = n
  lemma of_int_in_bounds:
    forall n: int [of_int n]. model (of_int n) = n

  val of_int (n: int) : t
    ensures  { model result = n }

  val constant min_value : t
    ensures { model result = min_value_model }

  val constant max_value : t
    ensures { model result = max_value_model }

  function eq (x: t) (y: t) : bool = model x = model y

  function ne (x: t) (y: t) : bool = model x <> model y

  function lt (x: t) (y: t) : bool = model x < model y

  function le (x: t) (y: t) : bool = model x <= model y

  function gt (x: t) (y: t) : bool = model x > model y

  function ge (x: t) (y: t) : bool = model x >= model y

  val eq (x: t) (y: t) : bool
    ensures { result <-> model x = model y }

  val ne (x: t) (y: t) : bool
    ensures { result <-> model x <> model y }

  val lt (x: t) (y: t) : bool
    ensures { result <-> model x < model y }

  val le (x: t) (y: t) : bool
    ensures { result <-> model x <= model y }

  val gt (x: t) (y: t) : bool
    ensures { result <-> model x > model y }

  val ge (x: t) (y: t) : bool
    ensures { result <-> model x >= model y }

  function neg (x: t) : t = -x
  lemma neg_in_bounds:
    forall x: t [neg x]. model (neg x) = -model x

  function add (x: t) (y: t) : t = x + y
  lemma add_in_bounds:
    forall x y: t [add x y]. model (add x y) = model x + model y

  function sub (x: t) (y: t) : t = x - y
  lemma sub_in_bounds:
    forall x y: t [sub x y]. model (sub x y) = model x - model y

  function mul (x: t) (y: t) : t = x * y
  lemma mul_in_bounds:
    forall x y: t [mul x y]. model (mul x y) = model x * model y

  function div (x: t) (y: t) : t = ComputerDivision.div x y
  lemma div_valid:
    forall x y: t [div x y].
      model y <> 0 -> model (div x y) = ComputerDivision.div (model x) (model y)

  function mod_ (x: t) (y: t) : t = ComputerDivision.mod x y
  lemma mod_valid:
    forall x y: t [mod_ x y].
      model y <> 0 -> model (mod_ x y) = ComputerDivision.mod (model x) (model y)

  val neg (x: t) : t
    ensures  { model result = -model x }

  val add (x: t) (y: t) : t
    ensures  { model result = model x + model y }

  val sub (x: t) (y: t) : t
    ensures  { model result = model x - model y }

  val mul (x: t) (y: t) : t
    ensures  { model result = model x * model y }

  val div (x: t) (y: t) : t
    requires { model y <> 0 }
    ensures  { model result = ComputerDivision.div (model x) (model y) }

  val mod_ (x: t) (y: t) : t
    requires { model y <> 0 }
    ensures  { model result = ComputerDivision.mod (model x) (model y) }
end

