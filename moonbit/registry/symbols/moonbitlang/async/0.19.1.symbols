{"key":"moonbitlang/async.Timer.Timer:Method","pkg":"moonbitlang/async","name":"Timer","parent":"moonbitlang/async.Timer","kind":["value_alias","method","moonbitlang/async.Timer.Timer:Method"],"sig_":"pub fn Timer::Timer(Int) -> Self","doc":"Create a new timer that expires after `duration` milliseconds.\n The timer will start immediately, and expire after the duration elapsed.","attrs":[["alias",["name","new"],true]]}
{"key":"moonbitlang/async/io.PipeRead.read_exactly:Method","pkg":"moonbitlang/async/io","name":"read_exactly","parent":"moonbitlang/async/io.PipeRead","kind":"method","sig_":"pub async fn PipeRead::read_exactly(Self, Int) -> Bytes","doc":"`reader.read_exactly(len)` read exactly `len` number of bytes from the reader.\n It will wait until enough number of bytes is available.\n If EOF is reached before enough data is read, `ReaderClosed` is raised.","attrs":[]}
