{"key":"moonbitlang/async.Timer.refresh:Method","pkg":"moonbitlang/async","name":"refresh","parent":"moonbitlang/async.Timer","kind":"method","sig_":"pub fn Timer::refresh(Self) -> Unit","doc":"Refresh a timer.\n If the timer has already terminated, it is restarted immediately,\n and will be triggered again after the timer expires.\n If the timer is currently active,\n its expiration time will be delayed to current time + duration of the timer.\n If the timer has been cancelled, `refresh` has no effect.","attrs":[]}
{"key":"moonbitlang/async/js_async.Promise.wait:Method","pkg":"moonbitlang/async/js_async","name":"wait","parent":"moonbitlang/async/js_async.Promise","kind":"method","sig_":"pub async fn[X] Promise::wait(Self[X], abort_controller? : AbortController) -> X","doc":"Wait for a JavaScript promise to resolve and return the fulfilled value,\n or raise an error if the promise is rejected.\n\n If `abort_controller` is provided,\n it should be an abort controller that controls the promise,\n and `.abort()` will be called on the controller automatically when `wait` is cancelled,\n cancelling the promise automatically.\n\n If `abort_controller` is absent, `wait` is non-cancellable.","attrs":[]}
{"key":"moonbitlang/async/aqueue.Queue.Queue:Method","pkg":"moonbitlang/async/aqueue","name":"Queue","parent":"moonbitlang/async/aqueue.Queue","kind":["value_alias","method","moonbitlang/async/aqueue.Queue.Queue:Method"],"sig_":"pub fn[X] Queue::Queue(kind~ : Kind) -> Self[X]","doc":"Create an empty queue.\n The behavior of `put` is determined by the `kind` argument,\n see the type `@aqueue.Kind` for more details.","attrs":[["alias",["name","new"],true],["as_free_fn","new",true]]}
{"key":"moonbitlang/async/js_async.ReadableStream.read_all:Method","pkg":"moonbitlang/async/js_async","name":"read_all","parent":"moonbitlang/async/js_async.ReadableStream","kind":"method","sig_":"pub async fn ReadableStream::read_all(Self) -> &@io.Data","doc":"Read all remaining content from the reader.\n The return value is a `&io.Data` object, which can be converted to different formats\n using `.binary()`, `.text()` or `.json()`.","attrs":[]}
{"key":"moonbitlang/async/internal/coroutine.Coroutine.wake:Method","pkg":"moonbitlang/async/internal/coroutine","name":"wake","parent":"moonbitlang/async/internal/coroutine.Coroutine","kind":"method","sig_":"pub fn Coroutine::wake(Self) -> Unit","doc":null,"attrs":[]}
