{"key":"moonbitlang/async.pause","pkg":"moonbitlang/async","name":"pause","parent":"moonbitlang/async","kind":["value_alias","function","moonbitlang/async/internal/coroutine.pause"],"sig_":"pub async fn pause() -> Unit","doc":null,"attrs":[]}
{"key":"moonbitlang/async/semaphore.Semaphore.release:Method","pkg":"moonbitlang/async/semaphore","name":"release","parent":"moonbitlang/async/semaphore.Semaphore","kind":"method","sig_":"pub fn Semaphore::release(Self) -> Unit","doc":"Release a unit of resource back to the semaphore. This function never blocks.\n If there are waiters currently blocked on the semaphore,\n the first waiter will be woken to acquire the resource.\n\n `release` must be called after a successful `acquire`,\n in strictly one-to-one manner.\n If the value of the semaphore exceed its size,\n `release` will abort immediately.","attrs":[]}
{"key":"moonbitlang/async.Lazy.new:Method","pkg":"moonbitlang/async","name":"new","parent":"moonbitlang/async.Lazy","kind":["attribute_value_alias","method","moonbitlang/async.Lazy.Lazy:Method"],"sig_":"pub fn[X] Lazy::new(async () -> X) -> Self[X]","doc":null,"attrs":["deprecated"]}
{"key":"moonbitlang/async/js_async.JsReadableStream","pkg":"moonbitlang/async/js_async","name":"JsReadableStream","parent":"moonbitlang/async/js_async","kind":"type","sig_":"type JsReadableStream","doc":"The `ReadableStream` type in Web API, see\n   https://developer.mozilla.org/en-US/docs/Web/API/ReadableStream\n for more details.\n\n Use this type on JavaScript FFI boundary to interact with\n API that make use of `ReadableStream`, such as `fetch`.","attrs":[]}
{"key":"moonbitlang/async.with_timeout_opt","pkg":"moonbitlang/async","name":"with_timeout_opt","parent":"moonbitlang/async","kind":"function","sig_":"pub async fn[X] with_timeout_opt(Int, async () -> X) -> X?","doc":"`with_timeout_opt(timeout, f)` run the async function `f`.\n\n - If `f` return `value` before `timeout`,\n   `with_timeout_opt` will return `Some(value)` immediately.\n\n - If `f` fail before `timeout`, `with_timeout_opt` will fail immediately.\n\n - If `f` is still running after `timeout` milliseconds,\n ` with_timeout_opt` will return `None` immediately, and `f` will be cancelled.","attrs":[]}
{"key":"moonbitlang/async/gzip.Decoder","pkg":"moonbitlang/async/gzip","name":"Decoder","parent":"moonbitlang/async/gzip","kind":"type","sig_":"struct Decoder[R]","doc":null,"attrs":[]}
{"key":"moonbitlang/async/internal/io_buffer.Buffer.start:Field","pkg":"moonbitlang/async/internal/io_buffer","name":"start","parent":"moonbitlang/async/internal/io_buffer.Buffer","kind":"field","sig_":"mut start : Int","doc":null,"attrs":[]}
{"key":"moonbitlang/async/js_async.ReadableStream.read_until:Method","pkg":"moonbitlang/async/js_async","name":"read_until","parent":"moonbitlang/async/js_async.ReadableStream","kind":"method","sig_":"pub async fn ReadableStream::read_until(Self, StringView) -> String?","doc":"`reader.read_until(sep)` read UTF-8 encoded text from the input stream\n until `sep` or EOF is reached.\n The segment of input from start of reader to start of `sep` or EOF is returned.\n `sep` will be conusmed from the input, but is not included in the return value.","attrs":[]}
{"key":"moonbitlang/async/internal/coroutine.no_more_work","pkg":"moonbitlang/async/internal/coroutine","name":"no_more_work","parent":"moonbitlang/async/internal/coroutine","kind":"function","sig_":"pub fn no_more_work() -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/async/io.PipeWrite.write_reader:Method","pkg":"moonbitlang/async/io","name":"write_reader","parent":"moonbitlang/async/io.PipeWrite","kind":"method","sig_":"pub async fn PipeWrite::write_reader(Self, &Reader) -> Unit","doc":null,"attrs":[]}
{"key":"moonbitlang/async.Task.try_wait:Method","pkg":"moonbitlang/async","name":"try_wait","parent":"moonbitlang/async.Task","kind":"method","sig_":"pub fn[X] Task::try_wait(Self[X]) -> X? raise","doc":"Try to obtain the result of the task.\n If the task already terminated, its result value will be returned.\n If the task already failed, `try_wait` will fail immediately.\n If the task is still running, `try_wait` returns `None`.\n `try_wait` is a synchoronous function: it never blocks.","attrs":[]}
{"key":"moonbitlang/async/semaphore.Semaphore.new:Method","pkg":"moonbitlang/async/semaphore","name":"new","parent":"moonbitlang/async/semaphore.Semaphore","kind":["attribute_value_alias","method","moonbitlang/async/semaphore.Semaphore.Semaphore:Method"],"sig_":"pub fn Semaphore::new(Int, initial_value? : Int) -> Self","doc":null,"attrs":["deprecated"]}
{"key":"moonbitlang/async/gzip.Decoder._direct_read:Method","pkg":"moonbitlang/async/gzip","name":"_direct_read","parent":"moonbitlang/async/gzip.Decoder","kind":"method","sig_":"pub async fn[R : @io.Reader] Decoder::_direct_read(Self[R], FixedArray[Byte], offset~ : Int, max_len~ : Int) -> Int","doc":null,"attrs":[]}
{"key":"moonbitlang/async.TaskGroup.add_defer:Method","pkg":"moonbitlang/async","name":"add_defer","parent":"moonbitlang/async.TaskGroup","kind":"method","sig_":"pub fn[X] TaskGroup::add_defer(Self[X], async () -> Unit) -> Unit","doc":"Attach a defer block, represented as a cleanup function, to a task group.\n The clenaup function will be invoked when the group terminates,\n so all child task of the group (created via `spawn` or `spawn_bg`)\n must have terminated when any group defer code is invoked.\n Calling `spawn` or `spawn_bg` inside group defer is not allowed,\n and will abort the program immediately.\n\n Group scoped defer blocks are executed in FILO order, just like normal `defer`.\n `with_task_group` will only exit after all group defer blocks terminate.\n\n Note that if the whole `with_task_group` is cancelled from outside,\n async operations in group defer block will be cancelled immediately too.\n Users can use `protect_from_cancel` to prevent async tasks from being cancelled.\n It is highly recommended to add a hard timeout to async defer block in this case,\n to avoid infinite hanging due to blocked operation.","attrs":[]}
{"key":"moonbitlang/async/io.Reader","pkg":"moonbitlang/async/io","name":"Reader","parent":"moonbitlang/async/io","kind":"trait","sig_":"trait Reader","doc":null,"attrs":[]}
