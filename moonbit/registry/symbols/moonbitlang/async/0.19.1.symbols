{"key":"moonbitlang/async.sleep","pkg":"moonbitlang/async","name":"sleep","parent":"moonbitlang/async","kind":"function","sig_":"pub async fn sleep(Int) -> Unit","doc":"`sleep` will wait for the given time (in milliseconds) before returning.\n Other task can still run while current task is sleeping.\n If current task is cancelled, `sleep` will return early with an error.","attrs":[]}
{"key":"moonbitlang/async/cond_var.Cond.signal:Method","pkg":"moonbitlang/async/cond_var","name":"signal","parent":"moonbitlang/async/cond_var.Cond","kind":"method","sig_":"pub fn Cond::signal(Self) -> Unit","doc":"Issue a single signal through the condition variable,\n waking up the first task waiting for the condition variable.\n If no task is waiting for the condition variable, nothing will happen.","attrs":[]}
{"key":"moonbitlang/async/io.Data.binary:Method","pkg":"moonbitlang/async/io","name":"binary","parent":"moonbitlang/async/io.Data","kind":"method","sig_":"pub fn &Data::binary(Self) -> Bytes","doc":"Extract the raw binary data from `&Data`","attrs":[]}
{"key":"moonbitlang/async/js_async.ReadableStream.drop:Method","pkg":"moonbitlang/async/js_async","name":"drop","parent":"moonbitlang/async/js_async.ReadableStream","kind":"method","sig_":"pub async fn ReadableStream::drop(Self, Int) -> Int","doc":"`reader.drop(len)` drops `len` number of bytes from the reader.\n The number of bytes actually dropped is returned.\n `drop` will wait until enough number of bytes is available,\n so the return value would be smaller than `len` only when EOF is reached.","attrs":[]}
{"key":"moonbitlang/async/js_async.Promise","pkg":"moonbitlang/async/js_async","name":"Promise","parent":"moonbitlang/async/js_async","kind":"type","sig_":"type Promise[X]","doc":"A JavaScript promise that resolves to a value of type `X`","attrs":[]}
{"key":"moonbitlang/async/io.pipe","pkg":"moonbitlang/async/io","name":"pipe","parent":"moonbitlang/async/io","kind":"function","sig_":"pub fn pipe() -> (PipeRead, PipeWrite)","doc":"Create a new in-memory pipe.\n Data written to the write end can be obtained from the read end.\n Useful for testing and converting writer-based function to reader.","attrs":[]}
