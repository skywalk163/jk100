{"key":"moonbitlang/async/io.ReaderClosed.to_string:Method","pkg":"moonbitlang/async/io","name":"to_string","parent":"moonbitlang/async/io.ReaderClosed","kind":"method","sig_":"pub fn ReaderClosed::to_string(Self) -> String","doc":"Default implementation for `Show::to_string`, uses a `StringBuilder`","attrs":["deprecated"]}
{"key":"moonbitlang/async/semaphore.Semaphore.Semaphore:Method","pkg":"moonbitlang/async/semaphore","name":"Semaphore","parent":"moonbitlang/async/semaphore.Semaphore","kind":["value_alias","method","moonbitlang/async/semaphore.Semaphore.Semaphore:Method"],"sig_":"pub fn Semaphore::Semaphore(Int, initial_value? : Int) -> Self","doc":"Create a semaphore of size `size`,\n the initial value of the semaphore\n will be set to `initial_value` (`size` by default)","attrs":[["alias",["name","new"],true]]}
{"key":"moonbitlang/async/internal/gzip_internal.Decoder.Decoder:Method","pkg":"moonbitlang/async/internal/gzip_internal","name":"Decoder","parent":"moonbitlang/async/internal/gzip_internal.Decoder","kind":["value_alias","method","moonbitlang/async/internal/gzip_internal.Decoder.Decoder:Method"],"sig_":"pub fn Decoder::Decoder() -> Self","doc":"Create a decoder state machine.\n The gzip header is consumed by the first successful `write` call.","attrs":[["alias",["name","new"],true]]}
{"key":"moonbitlang/core/builtin.Hash_for_moonbitlang/async/internal/coroutine.Coroutine","pkg":"moonbitlang/async/internal/coroutine","name":"moonbitlang/core/builtin.Hash_for_moonbitlang/async/internal/coroutine.Coroutine","parent":null,"kind":["impl","moonbitlang/core/builtin.Hash","moonbitlang/async/internal/coroutine.Coroutine"],"sig_":"pub impl Hash for Coroutine","doc":null,"attrs":[]}
