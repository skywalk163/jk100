{"key":"moonbitlang/async/internal/gzip_internal.Encoder.Encoder:Method","pkg":"moonbitlang/async/internal/gzip_internal","name":"Encoder","parent":"moonbitlang/async/internal/gzip_internal.Encoder","kind":["value_alias","method","moonbitlang/async/internal/gzip_internal.Encoder.Encoder:Method"],"sig_":"pub fn Encoder::Encoder(mtime? : UInt, extra_flags? : Byte, operating_system? : Byte) -> Self","doc":"Create an encoder state machine.\n The gzip header is written by the first successful `write` or `end` call.","attrs":[["alias",["name","new"],true]]}
