{"key":"moonbitlang/async/io.Data_for_moonbitlang/core/bytes.Bytes","pkg":"moonbitlang/async/io","name":"moonbitlang/async/io.Data_for_moonbitlang/core/bytes.Bytes","parent":null,"kind":["impl","moonbitlang/async/io.Data","moonbitlang/core/bytes.Bytes"],"sig_":"pub impl Data for Bytes","doc":null,"attrs":[]}
