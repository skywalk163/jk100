{"key":"moonbitlang/async/fs.unimplemented","pkg":"moonbitlang/async/fs","name":"unimplemented","parent":"moonbitlang/async/fs","kind":"let","sig_":"pub let unimplemented : Unit","doc":"This package currently does not support JavaScript backend","attrs":[]}
{"key":"moonbitlang/async/internal/coroutine.reschedule","pkg":"moonbitlang/async/internal/coroutine","name":"reschedule","parent":"moonbitlang/async/internal/coroutine","kind":"function","sig_":"pub fn reschedule() -> Unit","doc":"Perform a new rousd of scheduling by running all ready coroutines.\n While running these coroutines, new coroutines may get waken or spawned,\n these new coroutines will *not* get executed in this run of `reschedule`.\n This give the event loop a chance to check of completed IO operations\n and prevent starvation, even when there is always immediately ready coroutine.","attrs":[]}
{"key":"moonbitlang/async/internal/io_buffer.Buffer.new:Method","pkg":"moonbitlang/async/internal/io_buffer","name":"new","parent":"moonbitlang/async/internal/io_buffer.Buffer","kind":"method","sig_":"pub fn Buffer::new(Int) -> Self","doc":null,"attrs":[["as_free_fn",null,false]]}
