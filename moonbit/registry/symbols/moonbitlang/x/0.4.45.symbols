{"key":"moonbitlang/x/rational.Integral.from_int:Field","pkg":"moonbitlang/x/rational","name":"from_int","parent":"moonbitlang/x/rational.Integral","kind":"field","sig_":"from_int(Int) -> Self","doc":null,"attrs":[]}
{"key":"moonbitlang/x/rational.Rational.floor:Method","pkg":"moonbitlang/x/rational","name":"floor","parent":"moonbitlang/x/rational.Rational","kind":"method","sig_":"pub fn[T : Integral] Rational::floor(Self[T]) -> T","doc":"Computes the largest integer that is less than or equal to the rational\n number.\n\n Parameters:\n\n * `self` : The rational number to floor.\n\n Returns the largest value of type `T` that is less than or equal to `self`.\n\n Example:\n\n ```moonbit check\n test {\n   let r1 = @rational.new(7L, 3L).unwrap() // 7/3 ≈ 2.33\n   inspect(r1.floor(), content=\"2\")\n   let r2 = @rational.new(-7L, 3L).unwrap() // -7/3 ≈ -2.33\n   inspect(r2.floor(), content=\"-3\")\n   let r3 = @rational.new(6L, 3L).unwrap() // 6/3 = 2.0\n   inspect(r3.floor(), content=\"2\")\n }\n ```","attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/x/time.ZonedDateTime.ordinal:Method","pkg":"moonbitlang/x/time","name":"ordinal","parent":"moonbitlang/x/time.ZonedDateTime","kind":"method","sig_":"pub fn ZonedDateTime::ordinal(Self) -> Int","doc":"Returns the ordinal day of year of this datetime.","attrs":[]}
{"key":"moonbitlang/x/path/win32.Path.is_absolute:Method","pkg":"moonbitlang/x/path/win32","name":"is_absolute","parent":"moonbitlang/x/path/win32.Path","kind":"method","sig_":"pub fn Path::is_absolute(Self) -> Bool","doc":"Returns whether the given path is absolute.\n \n edge cases: when path is empty, return false\n \n ```moonbit check\n test {\n   let path1 : Path = \"C:\\\\Program Files\\\\App\"\n   let path2 : Path = \"Program Files\\\\App\"\n   json_inspect(path1.is_absolute(), content=true)\n   json_inspect(path2.is_absolute(), content=false)\n }\n ```","attrs":[]}
