{"key":"moonbitlang/x/sys.get_cli_args","pkg":"moonbitlang/x/sys","name":"get_cli_args","parent":"moonbitlang/x/sys","kind":"function","sig_":"pub fn get_cli_args() -> Array[String]","doc":"Gets the command line arguments passed to the program.\n\n This function returns `argv[0]` as the name of the program, and the rest are\n the other arguments passed to the program (C-style `argv` list). This list\n of arguments does not contain the runtime used to run the program, nor any\n arguments meant to be consumed by the runtime.","attrs":[]}
