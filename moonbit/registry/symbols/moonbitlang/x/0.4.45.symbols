{"key":"moonbitlang/x/rational.Rational.op_lt:Method","pkg":"moonbitlang/x/rational","name":"op_lt","parent":"moonbitlang/x/rational.Rational","kind":"method","sig_":"pub fn[T : Integral] Rational::op_lt(Self[T], Self[T]) -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/x/encoding.encode","pkg":"moonbitlang/x/encoding","name":"encode","parent":"moonbitlang/x/encoding","kind":"function","sig_":"pub fn encode(Encoding, String) -> Bytes","doc":"Encode a given string to the specified character encoding and returns the resulting bytes.\n\n # Parameters\n\n - `encoding` : The target encoding format.\n - `src`: The input string to be encoded.\n\n # Returns\n\n A `bytes` representing the encoded string in the selected format.\n\n # Examples\n\n ```moonbit check\n test {\n   let src = \"Hello, World!\"\n   let encoded_bytes = encode(UTF8, src)\n   assert_eq(\n     encoded_bytes,\n     Bytes::from_array([\n       72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33,\n     ]),\n   )\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/time.Period.to_string:Method","pkg":"moonbitlang/x/time","name":"to_string","parent":"moonbitlang/x/time.Period","kind":"method","sig_":"pub fn Period::to_string(Self) -> String","doc":"Returns a string representation of this period using ISO 8601 representation.","attrs":[]}
