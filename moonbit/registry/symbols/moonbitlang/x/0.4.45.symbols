{"key":"moonbitlang/x/decimal.Decimal.scale_to:Method","pkg":"moonbitlang/x/decimal","name":"scale_to","parent":"moonbitlang/x/decimal.Decimal","kind":"method","sig_":"pub fn Decimal::scale_to(Self, Int) -> Self?","doc":"Scales the decimal to have the specified number of decimal places.\n\n Parameters:\n * `self` : The decimal to scale\n * `new_scale` : New number of decimal places (0 <= new_scale <= max_scale)\n\n Returns `Some(decimal)` if new_scale is valid, `None` otherwise.\n\n Example:\n ```moonbit check\n test {\n   let d = match @decimal.Decimal::from_string(\"123.45\") {\n     Some(d) => d\n     None => fail(\"Invalid decimal string\")\n   }\n   let scaled = match d.scale_to(4) {\n     Some(s) => s\n     None => fail(\"Invalid scaling\")\n   }\n   inspect(scaled.to_string(), content=\"123.4500\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/rational.RationalError.not_equal:Method","pkg":"moonbitlang/x/rational","name":"not_equal","parent":"moonbitlang/x/rational.RationalError","kind":"method","sig_":"pub fn RationalError::not_equal(Self, Self) -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/core/debug.Debug_for_moonbitlang/x/encoding.MalformedError","pkg":"moonbitlang/x/encoding","name":"moonbitlang/core/debug.Debug_for_moonbitlang/x/encoding.MalformedError","parent":null,"kind":["impl","moonbitlang/core/debug.Debug","moonbitlang/x/encoding.MalformedError"],"sig_":"pub impl @debug.Debug for MalformedError","doc":null,"attrs":[]}
{"key":"moonbitlang/x/time.ZonedDateTime.add_hours:Method","pkg":"moonbitlang/x/time","name":"add_hours","parent":"moonbitlang/x/time.ZonedDateTime","kind":"method","sig_":"pub fn ZonedDateTime::add_hours(Self, Int64) -> Self raise","doc":"Adds specified hours to this datetime, and returns a new datetime.","attrs":[]}
{"key":"moonbitlang/x/path/posix.Path.resolve:Method","pkg":"moonbitlang/x/path/posix","name":"resolve","parent":"moonbitlang/x/path/posix.Path","kind":"method","sig_":"pub fn Path::resolve(Self) -> Self","doc":"1. if path is already absolute, return path normalized.\n 2. if path is relative, join current working directory and path, and then normalize it.\n\n Warning: cwd is already resolve symbolic link and normalized, but path doesn't.\n \n ```moonbit skip nocheck\n let path : Path = \"project/src\"\n inspect(path.resolve(), content=\"/your/current_working_directory/project/src\")\n ```","attrs":[]}
{"key":"moonbitlang/x/path/win32.Path.extname:Method","pkg":"moonbitlang/x/path/win32","name":"extname","parent":"moonbitlang/x/path/win32.Path","kind":"method","sig_":"pub fn Path::extname(Self) -> StringView","doc":"Returns the string of the basename after the last `.` delimiter.\n \n ```moonbit check\n test {\n   let path : Path = \"archive.tar.gz\"\n   inspect(path.extname(), content=\".gz\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/decimal.Decimal.div:Method","pkg":"moonbitlang/x/decimal","name":"div","parent":"moonbitlang/x/decimal.Decimal","kind":"method","sig_":"pub fn Decimal::div(Self, Self) -> Self","doc":"Implements division with maximum precision.","attrs":[]}
{"key":"moonbitlang/x/stack.Stack.unsafe_peek:Method","pkg":"moonbitlang/x/stack","name":"unsafe_peek","parent":"moonbitlang/x/stack.Stack","kind":"method","sig_":"pub fn[T] Stack::unsafe_peek(Self[T]) -> T","doc":"Only the top element of the stack is returned and will not be pop or drop.\n If there are elements in the stack, return the top element of the stack, otherwise abort.\n\n @alert unsafe \"Panic if the stack is empty.\"","attrs":[]}
{"key":"moonbitlang/x/time.ZoneOffset.is_dst:Method","pkg":"moonbitlang/x/time","name":"is_dst","parent":"moonbitlang/x/time.ZoneOffset","kind":"method","sig_":"pub fn ZoneOffset::is_dst(Self) -> Bool","doc":"Checks if this offset is daylight saving time.","attrs":[]}
