{"key":"moonbitlang/x/time.ZonedDateTime.with_nanosecond:Method","pkg":"moonbitlang/x/time","name":"with_nanosecond","parent":"moonbitlang/x/time.ZonedDateTime","kind":"method","sig_":"pub fn ZonedDateTime::with_nanosecond(Self, Int) -> Self raise","doc":"Returns a new datetime with the specified nanosecond.","attrs":[]}
{"key":"moonbitlang/x/time.Period.is_neg:Method","pkg":"moonbitlang/x/time","name":"is_neg","parent":"moonbitlang/x/time.Period","kind":"method","sig_":"pub fn Period::is_neg(Self) -> Bool","doc":"Checks if this period is negative.","attrs":[]}
{"key":"moonbitlang/x/time.Duration","pkg":"moonbitlang/x/time","name":"Duration","parent":"moonbitlang/x/time","kind":"type","sig_":"type Duration","doc":"An amount of time with nanosecond precision.","attrs":[]}
{"key":"moonbitlang/x/rational.Rational.op_gt:Method","pkg":"moonbitlang/x/rational","name":"op_gt","parent":"moonbitlang/x/rational.Rational","kind":"method","sig_":"pub fn[T : Integral] Rational::op_gt(Self[T], Self[T]) -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/x/path.Path.normalize:Method","pkg":"moonbitlang/x/path","name":"normalize","parent":"moonbitlang/x/path.Path","kind":"method","sig_":"pub fn Path::normalize(Self) -> Self","doc":"1. resolve `.` by directly removing it\n 2. resolve `..` by removing the preceding path component if exists, otherwise keep it.\n 3. remove redundant slashes or backslashes\n 4. preserve trailing slash or backslash\n \n edge cases:\n   1. when path is empty, return empty string\n   2. when path is contains two leading forward slashes like `//`, return `//`. respect POSIX standard, this behavior is inconsistent with Node.js path module.\n \n ```moonbit skip nocheck\n let path : Path = \"/usr//local/../bin/\"\n inspect(path.normalize(), content=\"/usr/bin\")\n ```","attrs":[]}
{"key":"moonbitlang/x/crypto.sm3","pkg":"moonbitlang/x/crypto","name":"sm3","parent":"moonbitlang/x/crypto","kind":"function","sig_":"pub fn[Data : ByteSource] sm3(Data) -> FixedArray[Byte]","doc":"Compute the SM3 digest in `FixedArray[Byte]` of some `data`. Note that SM3 is big-endian.","attrs":[]}
