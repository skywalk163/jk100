{"key":"moonbitlang/x/internal/ffi.XExternStringArray","pkg":"moonbitlang/x/internal/ffi","name":"XExternStringArray","parent":"moonbitlang/x/internal/ffi","kind":"type","sig_":"type XExternStringArray","doc":null,"attrs":[]}
{"key":"moonbitlang/x/rational.Rational.output:Method","pkg":"moonbitlang/x/rational","name":"output","parent":"moonbitlang/x/rational.Rational","kind":"method","sig_":"pub fn[T : Integral] Rational::output(Self[T], &Logger) -> Unit","doc":"Converts a rational number to its string representation.\n\n Parameters:\n\n * `self` : The rational number to convert.\n * `logger` : The output logger to write the string representation to.\n\n The string representation follows these rules:\n\n * If the numerator is zero, outputs \"0\"\n * If the denominator is 1 (i.e., the rational is an integer), outputs just\n the numerator\n * Otherwise, outputs in the format \"numerator/denominator\"\n\n Example:\n\n ```moonbit check\n test {\n   let zero = @rational.new(0L, 1).unwrap()\n   inspect(zero, content=\"0\")\n   let integer = @rational.new(5L, 1).unwrap()\n   inspect(integer, content=\"5\")\n   let fraction = @rational.new(3L, 4).unwrap()\n   inspect(fraction, content=\"3/4\")\n   let negative = @rational.new(-7L, 3).unwrap()\n   inspect(negative, content=\"-7/3\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/time.PlainDateTime.minute:Method","pkg":"moonbitlang/x/time","name":"minute","parent":"moonbitlang/x/time.PlainDateTime","kind":"method","sig_":"pub fn PlainDateTime::minute(Self) -> Int","doc":"Returns the minute of this datetime.","attrs":[]}
{"key":"moonbitlang/x/uuid.Version.V4","pkg":"moonbitlang/x/uuid","name":"V4","parent":"moonbitlang/x/uuid.Version","kind":"variant","sig_":"V4","doc":null,"attrs":[]}
{"key":"moonbitlang/x/rational.RationalError.equal:Method","pkg":"moonbitlang/x/rational","name":"equal","parent":"moonbitlang/x/rational.RationalError","kind":"method","sig_":"pub fn RationalError::equal(Self, Self) -> Bool","doc":"Compares two `RationalError` values for equality.\n\n Parameters:\n\n * `self` : The first `RationalError` to compare.\n * `other` : The second `RationalError` to compare.\n\n Returns `true` if both `RationalError` values contain the same error message,\n `false` otherwise.\n\n Example:\n\n ```moonbit check\n test {\n   let error1 = @rational.RationalError(\"division by zero\")\n   let error2 = @rational.RationalError(\"division by zero\")\n   let error3 = @rational.RationalError(\"overflow\")\n   inspect(error1 == error2, content=\"true\")\n   inspect(error1 == error3, content=\"false\")\n }\n ```","attrs":[]}
