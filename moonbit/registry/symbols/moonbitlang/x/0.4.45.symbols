{"key":"moonbitlang/x/decimal.max_scale","pkg":"moonbitlang/x/decimal","name":"max_scale","parent":"moonbitlang/x/decimal","kind":"let","sig_":"pub let max_scale : Int","doc":"Maximum number of decimal places (scale) allowed.","attrs":[]}
{"key":"moonbitlang/x/decimal.Decimal","pkg":"moonbitlang/x/decimal","name":"Decimal","parent":"moonbitlang/x/decimal","kind":"type","sig_":"struct Decimal","doc":"Arbitrary precision decimal type for exact decimal arithmetic.\n\n This type is designed for financial calculations and other applications\n that require exact decimal representation without floating-point errors.\n\n The decimal is represented as a coefficient (BigInt) and a scale (Int):\n - coefficient: The significant digits as a BigInt\n - scale: The number of decimal places (0 <= scale <= max_scale)\n\n For example: 123.45 is represented as coefficient=12345, scale=2\n\n Invariants:\n - 0 <= scale <= max_scale (default 28)\n - coefficient and scale are normalized (no trailing zeros in coefficient)\n - Zero is represented as coefficient=0, scale=0\n\n Example:\n ```moonbit check\n test {\n   let price = match @decimal.Decimal::from_string(\"19.99\") {\n     Some(p) => p\n     None => fail(\"Invalid price\")\n   }\n   let tax = match @decimal.Decimal::from_string(\"0.08\") {\n     Some(t) => t\n     None => fail(\"Invalid tax rate\")\n   }\n   let total = price + tax\n   inspect(total.to_string(), content=\"20.07\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/crypto.SM3.reset:Method","pkg":"moonbitlang/x/crypto","name":"reset","parent":"moonbitlang/x/crypto.SM3","kind":"method","sig_":"pub fn SM3::reset(Self) -> Unit","doc":null,"attrs":[]}
{"key":"moonbitlang/x/fs.remove_file","pkg":"moonbitlang/x/fs","name":"remove_file","parent":"moonbitlang/x/fs","kind":"function","sig_":"pub fn remove_file(String) -> Unit raise IOError","doc":"Removes a file at the specified path.\n\n # Parameters\n\n - `path` : The path to the file that needs to be removed.","attrs":[]}
{"key":"moonbitlang/x/time.PlainTime.minute:Method","pkg":"moonbitlang/x/time","name":"minute","parent":"moonbitlang/x/time.PlainTime","kind":"method","sig_":"pub fn PlainTime::minute(Self) -> Int","doc":"Returns the minute of this time.","attrs":[]}
{"key":"moonbitlang/x/fs.read_file_to_string","pkg":"moonbitlang/x/fs","name":"read_file_to_string","parent":"moonbitlang/x/fs","kind":"function","sig_":"pub fn read_file_to_string(String, encoding? : String) -> String raise IOError","doc":"Reads the content of a file specified by the given path and returns its\n content as `String`.\n\n # Parameters\n\n - `path` : The path to the file to be read.\n - `encoding~` : The encoding of the file. Only support `utf8` for now.\n\n # Returns\n\n - A `String` representing the content of the file.","attrs":[]}
{"key":"moonbitlang/x/time.Weekday.to_string:Method","pkg":"moonbitlang/x/time","name":"to_string","parent":"moonbitlang/x/time.Weekday","kind":"method","sig_":"pub fn Weekday::to_string(Self) -> String","doc":"Default implementation for `Show::to_string`, uses a `StringBuilder`","attrs":[]}
