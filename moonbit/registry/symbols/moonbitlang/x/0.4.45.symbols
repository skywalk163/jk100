{"key":"moonbitlang/x/path/posix.Path.join:Method","pkg":"moonbitlang/x/path/posix","name":"join","parent":"moonbitlang/x/path/posix.Path","kind":"method","sig_":"pub fn Path::join(Self, Self) -> Self","doc":"1. string concatenation with OS platform specific path separator\n 2. if rhs is absolute path, return rhs\n \n edge cases:\n  1. when lhs and rhs both are empty, return empty string\n  2. ignore empty string\n \n ```moonbit check\n test {\n   let path : Path = \"/usr/local\"\n   inspect(path.join(\"bin\"), content=\"/usr/local/bin\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/time.ZonedDateTime.with_minute:Method","pkg":"moonbitlang/x/time","name":"with_minute","parent":"moonbitlang/x/time.ZonedDateTime","kind":"method","sig_":"pub fn ZonedDateTime::with_minute(Self, Int) -> Self raise","doc":"Returns a new datetime with the specified minute.","attrs":[]}
{"key":"moonbitlang/x/rational.Rational.compare:Method","pkg":"moonbitlang/x/rational","name":"compare","parent":"moonbitlang/x/rational.Rational","kind":"method","sig_":"pub fn[T : Integral] Rational::compare(Self[T], Self[T]) -> Int","doc":"Compares two rational numbers and returns their ordering.\n\n Parameters:\n\n * `self` : The first rational number to compare.\n * `other` : The second rational number to compare.\n\n Returns an integer indicating the relative order: negative if `self` is less\n than `other`, zero if they are equal, and positive if `self` is greater than\n `other`.\n\n Example:\n\n ```moonbit check\n test {\n   let a = @rational.new(1L, 2L).unwrap() // 1/2\n   let b = @rational.new(2L, 3L).unwrap() // 2/3\n   inspect(a.compare(b), content=\"-1\") // 1/2 < 2/3\n   let c = @rational.new(3L, 4L).unwrap() // 3/4\n   let d = @rational.new(3L, 4L).unwrap() // 3/4\n   inspect(c.compare(d), content=\"0\") // 3/4 == 3/4\n   let e = @rational.new(5L, 6L).unwrap() // 5/6\n   let f = @rational.new(1L, 2L).unwrap() // 1/2\n   inspect(e.compare(f), content=\"1\") // 5/6 > 1/2\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/time.ZonedDateTime.to_plain_date_time:Method","pkg":"moonbitlang/x/time","name":"to_plain_date_time","parent":"moonbitlang/x/time.ZonedDateTime","kind":"method","sig_":"pub fn ZonedDateTime::to_plain_date_time(Self) -> PlainDateTime","doc":"Returns the datetime part of this datetime, without timezone.","attrs":[]}
{"key":"moonbitlang/x/time.Period.with_months:Method","pkg":"moonbitlang/x/time","name":"with_months","parent":"moonbitlang/x/time.Period","kind":"method","sig_":"pub fn Period::with_months(Self, Int) -> Self","doc":"Returns a new period with the specified amount of months.","attrs":[]}
{"key":"moonbitlang/x/time.Duration.op_add:Method","pkg":"moonbitlang/x/time","name":"op_add","parent":"moonbitlang/x/time.Duration","kind":"method","sig_":"pub fn Duration::op_add(Self, Self) -> Self raise","doc":null,"attrs":[]}
{"key":"moonbitlang/x/path/win32.Path.dirname:Method","pkg":"moonbitlang/x/path/win32","name":"dirname","parent":"moonbitlang/x/path/win32.Path","kind":"method","sig_":"pub fn Path::dirname(Self) -> Self","doc":"Returns path without its last path component and trailing backslashes.\n \n property: `@path.join(@path.dirname(path), @path.basename(path)) == path`\n \n Warning: basename function not respect this POSIX standard, but consistent with Python `os.path` module.\n \n ```moonbit check\n test {\n   let path : Path = \"usr\\\\local\\\\bin\"\n   inspect(path.dirname(), content=\"usr\\\\local\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/x/time.PlainDate.until:Method","pkg":"moonbitlang/x/time","name":"until","parent":"moonbitlang/x/time.PlainDate","kind":"method","sig_":"pub fn PlainDate::until(Self, Self) -> Period raise","doc":"Returns the period between this date and another date.","attrs":[]}
{"key":"moonbitlang/x/path/posix","pkg":"moonbitlang/x/path/posix","name":"moonbitlang/x/path/posix","parent":null,"kind":"package","sig_":null,"doc":null,"attrs":[]}
