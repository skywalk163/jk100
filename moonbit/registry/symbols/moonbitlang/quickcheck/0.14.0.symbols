{"key":"moonbitlang/quickcheck/gen.Gen.ap:Method","pkg":"moonbitlang/quickcheck/gen","name":"ap","parent":"moonbitlang/quickcheck/gen.Gen","kind":"method","sig_":"pub fn[T, U] Gen::ap(Self[(T) -> U], Self[T]) -> Self[U]","doc":"Applicative Functor instance for Gen[T]","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.sized","pkg":"moonbitlang/quickcheck/gen","name":"sized","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T] sized((Int) -> Gen[T]) -> Gen[T]","doc":"Create sized generators","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.flatten_list","pkg":"moonbitlang/quickcheck/gen","name":"flatten_list","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T] flatten_list(@list.List[Gen[T]]) -> Gen[@list.List[T]]","doc":"Generate a list of elements from individual generators","attrs":[]}
{"key":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/builtin.Iter","pkg":"moonbitlang/quickcheck/shrink","name":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/builtin.Iter","parent":null,"kind":["impl","moonbitlang/quickcheck/shrink.Shrink","moonbitlang/core/builtin.Iter"],"sig_":"pub impl[X : Shrink] Shrink for Iter[X]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.iter:Method","pkg":"moonbitlang/quickcheck/internal/lazy","name":"iter","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"method","sig_":"pub fn[T] LazyList::iter(Self[T]) -> Iter[T]","doc":"Lazy traversal: walks the list head-first, yielding each element\n as the iterator is pulled. Because MoonBit's `for x in <expr>`\n desugars to `<expr>.iter()`, this enables\n\n     for x in lazy_list { ... }\n\n on any `LazyList[T]`.\n\n Only the cells actually consumed are forced — pairing with `take`\n or breaking out of the loop early avoids touching the rest. Like\n every `Iter` in MoonBit it is single-shot.","attrs":[]}
{"key":"moonbitlang/core/builtin.Add_for_moonbitlang/quickcheck/feat.Finite","pkg":"moonbitlang/quickcheck/feat","name":"moonbitlang/core/builtin.Add_for_moonbitlang/quickcheck/feat.Finite","parent":null,"kind":["impl","moonbitlang/core/builtin.Add","moonbitlang/quickcheck/feat.Finite"],"sig_":"pub impl[T] Add for Finite[T]","doc":null,"attrs":[]}
