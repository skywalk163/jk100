{"key":"moonbitlang/quickcheck/feat.Enumerable_for_moonbitlang/core/byte.Byte","pkg":"moonbitlang/quickcheck/feat","name":"moonbitlang/quickcheck/feat.Enumerable_for_moonbitlang/core/byte.Byte","parent":null,"kind":["impl","moonbitlang/quickcheck/feat.Enumerable","moonbitlang/core/byte.Byte"],"sig_":"pub impl Enumerable for Byte","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/laws.Equivalence.fmap:Method","pkg":"moonbitlang/quickcheck/laws","name":"fmap","parent":"moonbitlang/quickcheck/laws.Equivalence","kind":"method","sig_":"pub fn[T, U] Equivalence::fmap(Self[T], (T) -> U) -> Self[U]","doc":"Functor `fmap` on both sides: `Equivalence::fmap({a, b}, f)` is\n `{f(a), f(b)}`. Useful for wrapping a law in a coercion, e.g.\n comparing two `Array`s via `.to_list()`.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.finished_successfully:Method","pkg":"moonbitlang/quickcheck/internal/state","name":"finished_successfully","parent":"moonbitlang/quickcheck/internal/state.State","kind":"method","sig_":"pub fn State::finished_successfully(Self) -> Bool","doc":"`true` once the run has gathered enough passing samples to stop.","attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.NonZero.shrink:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"shrink","parent":"moonbitlang/quickcheck/modifiers.NonZero","kind":"method","sig_":"pub fn NonZero::shrink(Self[Int]) -> Iter[Self[Int]]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.tail:Method","pkg":"moonbitlang/quickcheck/internal/lazy","name":"tail","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"method","sig_":"pub fn[T] LazyList::tail(Self[T]) -> Self[T]","doc":"Everything after the first element. **Aborts** on `Nil`.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList","pkg":"moonbitlang/quickcheck/internal/lazy","name":"LazyList","parent":"moonbitlang/quickcheck/internal/lazy","kind":"type","sig_":"enum LazyList[T]","doc":"A call-by-need list: either empty (`Nil`) or a head value paired\n with a thunk producing the rest (`Cons(head, LazyRef<tail>)`).\n Because the tail is a `LazyRef`, infinite lists (`repeat`,\n `infinite_stream`) are representable and cheap — only the prefix\n you iterate is forced.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/report.TestError.Fail","pkg":"moonbitlang/quickcheck/internal/report","name":"Fail","parent":"moonbitlang/quickcheck/internal/report.TestError","kind":"variant","sig_":"Fail(num_tests~ : Int, num_discarded~ : Int, num_shrinks~ : Int, num_shrink_tries~ : Int, num_shrink_final~ : Int, reason~ : String, error~ : Error, output~ : String, coverage~ : @state.Coverage, failing_case~ : Array[String], failing_labels~ : Array[String], failing_classes~ : @sorted_set.SortedSet[String])","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/gen.Gen.array_with_size:Method","pkg":"moonbitlang/quickcheck/gen","name":"array_with_size","parent":"moonbitlang/quickcheck/gen.Gen","kind":"method","sig_":"pub fn[T] Gen::array_with_size(Self[T], Int) -> Self[Array[T]]","doc":"Lift a per-element generator to a generator of arrays with exactly\n `size` elements. Each element is drawn independently from the same\n sample tree.\n\n ```mbt check\n test {\n   let g = pure(0).array_with_size(4)\n   @debug.assert_eq(g.sample(), [0, 0, 0, 0])\n }\n ```","attrs":[]}
{"key":"moonbitlang/quickcheck/property.Arrow","pkg":"moonbitlang/quickcheck/property","name":"Arrow","parent":"moonbitlang/quickcheck/property","kind":"type","sig_":"struct Arrow[A, B]((A) -> B)","doc":"`Arrow[A, B]` is a newtype wrapper around a pure, total function\n `(A) -> B`. Wrapping is what lets the package implement `Testable`\n for generated inputs; MoonBit does not allow implementing a trait\n directly on the bare function type `(A) -> B`.","attrs":[]}
{"key":"moonbitlang/quickcheck/feat.Finite.iter:Method","pkg":"moonbitlang/quickcheck/feat","name":"iter","parent":"moonbitlang/quickcheck/feat.Finite","kind":"method","sig_":"pub fn[T] Finite::iter(Self[T]) -> Iter[T]","doc":"Lazy traversal over the chunk: walks indices `0, 1, 2, …, fCard-1`\n and yields `fIndex(i)` at each step. Because MoonBit's\n `for x in <expr>` desugars to `<expr>.iter()`, this is what lets\n you use a `Finite[T]` directly with the loop sugar.\n\n The traversal is lazy: early `break` stops calling `fIndex`.\n Like every `Iter` in MoonBit it is single-shot.\n\n ```mbt check\n test {\n   let squares : Finite[BigInt] = { fCard: 4, fIndex: j => j * j }\n   @debug.assert_eq(squares.iter().collect(), [0, 1, 4, 9])\n }\n ```","attrs":[]}
{"key":"moonbitlang/quickcheck.Testable","pkg":"moonbitlang/quickcheck","name":"Testable","parent":"moonbitlang/quickcheck","kind":["trait_alias","moonbitlang/quickcheck/property.Testable"],"sig_":"pub using @property {trait Testable}","doc":"Re-export property/testable types from the lower-level property\n package.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/report.CheckReport.render:Method","pkg":"moonbitlang/quickcheck/internal/report","name":"render","parent":"moonbitlang/quickcheck/internal/report.CheckReport","kind":"method","sig_":"pub fn CheckReport::render(Self, verbose? : Bool) -> String","doc":"Format the report as a human-readable string. `verbose=true`\n expands the failure block with labels, classes, shrink counts,\n and full coverage.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.map_size","pkg":"moonbitlang/quickcheck/property","name":"map_size","parent":"moonbitlang/quickcheck/property","kind":"function","sig_":"pub fn[P : Testable] map_size(P, (Int) -> Int) -> Property","doc":"Adjust the size parameter before running `p`. Equivalent to\n `Gen::scale(f)` but lifted to the `Testable` level.","attrs":[]}
