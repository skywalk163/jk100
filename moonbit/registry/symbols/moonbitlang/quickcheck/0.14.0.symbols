{"key":"moonbitlang/quickcheck/internal/report.TestError","pkg":"moonbitlang/quickcheck/internal/report","name":"TestError","parent":"moonbitlang/quickcheck/internal/report","kind":"type","sig_":"suberror TestError","doc":"Failure outcomes the driver can `raise`. `Fail` carries the\n shrunk counter-example and shrink tally; `GaveUp` reports a run\n that exhausted its discard budget; `NoneExpectedFail` is raised\n when the user `expect=Fail` but the property kept passing.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.max_success_tests_:Field","pkg":"moonbitlang/quickcheck/internal/state","name":"max_success_tests_","parent":"moonbitlang/quickcheck/internal/state.State","kind":"field","sig_":"mut max_success_tests_ : Int","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/property.Property.filter:Method","pkg":"moonbitlang/quickcheck/property","name":"filter","parent":"moonbitlang/quickcheck/property.Property","kind":"method","sig_":"pub fn Property::filter(Self, Bool) -> Self","doc":"Method form of `filter`, useful for chaining property decorators.","attrs":[]}
{"key":"moonbitlang/quickcheck/feat.Enumerate.sample_finite:Method","pkg":"moonbitlang/quickcheck/feat","name":"sample_finite","parent":"moonbitlang/quickcheck/feat.Enumerate","kind":"method","sig_":"pub fn[T] Enumerate::sample_finite(Self[T], Int) -> Finite[T]","doc":"Finite sampling domain used by `feat_random`. It aggregates\n the first `size` parts; if they are all empty, it continues to the\n next non-empty part so the result is still finite.","attrs":[]}
{"key":"moonbitlang/quickcheck.collect","pkg":"moonbitlang/quickcheck","name":"collect","parent":"moonbitlang/quickcheck","kind":["value_alias","function","moonbitlang/quickcheck/property.collect"],"sig_":"pub fn[P : @property.Testable, T : Show] collect(P, T) -> @property.Property","doc":"Attaches a rendered value as a label to a test case.","attrs":[]}
{"key":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.NonEmptyArray","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.NonEmptyArray","parent":null,"kind":["impl","moonbitlang/core/builtin.Eq","moonbitlang/quickcheck/modifiers.NonEmptyArray"],"sig_":"pub impl[T : Eq] Eq for NonEmptyArray[T]","doc":null,"attrs":[]}
