{"key":"moonbitlang/quickcheck/modifiers.NonEmptyList.equal:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"equal","parent":"moonbitlang/quickcheck/modifiers.NonEmptyList","kind":"method","sig_":"pub fn[T : Eq] NonEmptyList::equal(Self[T], Self[T]) -> Bool","doc":"automatically derived","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.pure","pkg":"moonbitlang/quickcheck/gen","name":"pure","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T] pure(T) -> Gen[T]","doc":"Functor instance for Gen[T] (pure)\n\n ```mbt check\n test {\n   // A pure generator ignores size and rng and always yields the value.\n   assert_eq(pure(42).sample(), 42)\n   assert_eq(pure(\"hi\").sample(), \"hi\")\n }\n ```","attrs":[]}
{"key":"moonbitlang/quickcheck/feat.Enumerable","pkg":"moonbitlang/quickcheck/feat","name":"Enumerable","parent":"moonbitlang/quickcheck/feat","kind":"trait","sig_":"trait Enumerable","doc":"Types that can enumerate all of their values in size-indexed order.\n\n `enumerate()` returns an `Enumerate[Self]`: a lazy stream of parts\n where the `k`-th part contains every value of size `k`. Primitive\n types already implement this trait; algebraic composites (sums,\n products, recursive types) compose via `singleton` / `+` /\n `product` / `unary` wrapped in a single `pay`.\n\n See the package README for the full contract, the built-in\n instance table, and the recipe for implementing `Enumerable` on a\n user-defined recursive type.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.to_repr:Method","pkg":"moonbitlang/quickcheck/internal/lazy","name":"to_repr","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"method","sig_":"pub fn[T : @debug.Debug] LazyList::to_repr(Self[T]) -> @debug.Repr","doc":"Renders the list in the canonical `[a, b, c, ...]` form. **Forces\n the entire list**, so don't call this on an infinite stream.","attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/quickcheck.quick_check_fn","pkg":"moonbitlang/quickcheck","name":"quick_check_fn","parent":"moonbitlang/quickcheck","kind":"function","sig_":"pub fn[A : @moonbitlang/core/quickcheck.Arbitrary + @shrink.Shrink + @debug.Debug, B : @property.Testable] quick_check_fn((A) -> B, max_shrinks? : Int, max_success? : Int, max_size? : Int, discard_ratio? : Int, expect? : @state.Expected, abort? : Bool, verbose? : Bool) -> Unit raise Failure","doc":"Thin sugar over `quick_check`: accept a plain `(A) -> B` property\n function, wrap it in `Arrow`, and run. The shortest path from a\n user-written property to a full QuickCheck run.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/report.TestSuccess.Success","pkg":"moonbitlang/quickcheck/internal/report","name":"Success","parent":"moonbitlang/quickcheck/internal/report.TestSuccess","kind":"variant","sig_":"Success(num_tests~ : Int, coverage~ : @state.Coverage, output~ : String)","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/report.CheckReport","pkg":"moonbitlang/quickcheck/internal/report","name":"CheckReport","parent":"moonbitlang/quickcheck/internal/report","kind":"type","sig_":"struct CheckReport(Result[TestSuccess, TestError])","doc":"The aggregated outcome of a QuickCheck run: a `TestSuccess` on the\n happy path, a `TestError` when the property failed (or was given\n up on, or unexpectedly passed). Wrapped as a newtype so renderers\n can hang as methods.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.collect","pkg":"moonbitlang/quickcheck/property","name":"collect","parent":"moonbitlang/quickcheck/property","kind":"function","sig_":"pub fn[P : Testable, T : Show] collect(P, T) -> Property","doc":"Attaches a rendered value as a label to a test case.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.Callback.PostTest","pkg":"moonbitlang/quickcheck/internal/state","name":"PostTest","parent":"moonbitlang/quickcheck/internal/state.Callback","kind":"variant","sig_":"PostTest(Kind, (State, SingleResult) -> Unit)","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/list.List","pkg":"moonbitlang/quickcheck/shrink","name":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/list.List","parent":null,"kind":["impl","moonbitlang/quickcheck/shrink.Shrink","moonbitlang/core/list.List"],"sig_":"pub impl[T : Shrink] Shrink for @list.List[T]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/gen.liftA3","pkg":"moonbitlang/quickcheck/gen","name":"liftA3","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[A, B, C, D] liftA3((A, B, C) -> D, Gen[A], Gen[B], Gen[C]) -> Gen[D]","doc":"Lift a ternary function to generators","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.quad","pkg":"moonbitlang/quickcheck/gen","name":"quad","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T, U, V, W] quad(Gen[T], Gen[U], Gen[V], Gen[W]) -> Gen[(T, U, V, W)]","doc":"Create quad generator from four generators","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.update_state_from_res:Method","pkg":"moonbitlang/quickcheck/internal/state","name":"update_state_from_res","parent":"moonbitlang/quickcheck/internal/state.State","kind":"method","sig_":"pub fn State::update_state_from_res(Self, SingleResult) -> Unit","doc":"Propagate any `maybe_*` overrides that combinators (e.g.\n `with_max_tests`) attached to `result` back onto `State`, and\n sync `expected` with whatever the property annotated itself with.\n Called once per sample before the verdict is inspected.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.callback","pkg":"moonbitlang/quickcheck/property","name":"callback","parent":"moonbitlang/quickcheck/property","kind":"function","sig_":"pub fn[P : Testable] callback(P, @state.Callback) -> Property","doc":"Attach a post-test or post-final-failure callback to `p`.","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.Gen.spawn:Method","pkg":"moonbitlang/quickcheck/gen","name":"spawn","parent":"moonbitlang/quickcheck/gen.Gen","kind":"method","sig_":"pub fn[T : @quickcheck.Arbitrary] Gen::spawn() -> Self[T]","doc":"Spawn a new generator from an arbitrary instance","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.liftA5","pkg":"moonbitlang/quickcheck/gen","name":"liftA5","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[A, B, C, D, E, F] liftA5((A, B, C, D, E) -> F, Gen[A], Gen[B], Gen[C], Gen[D], Gen[E]) -> Gen[F]","doc":"Lift a quinary function to generators","attrs":[]}
{"key":"moonbitlang/quickcheck/property","pkg":"moonbitlang/quickcheck/property","name":"moonbitlang/quickcheck/property","parent":null,"kind":"package","sig_":null,"doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/gen.Gen.such_that_maybe:Method","pkg":"moonbitlang/quickcheck/gen","name":"such_that_maybe","parent":"moonbitlang/quickcheck/gen.Gen","kind":"method","sig_":"pub fn[T] Gen::such_that_maybe(Self[T], (T) -> Bool) -> Self[T?]","doc":"Attempt to generate a value that satisfies a predicate\n If failures reach the maximum size, return None","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.SingleResult.maybe_max_shrinks:Field","pkg":"moonbitlang/quickcheck/internal/state","name":"maybe_max_shrinks","parent":"moonbitlang/quickcheck/internal/state.SingleResult","kind":"field","sig_":"maybe_max_shrinks : Int?","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.SingleResult","pkg":"moonbitlang/quickcheck/internal/state","name":"SingleResult","parent":"moonbitlang/quickcheck/internal/state","kind":"type","sig_":"struct SingleResult","doc":"Everything the driver learns about a single generated input. The\n leaf payload of the `@rose.Rose[SingleResult]` tree that every\n `Testable` collapses to — so each node in the shrink tree\n (the original sample plus every candidate tried during shrinking)\n carries one of these.\n\n Fields split into three groups:\n\n - The verdict: `status` (pass / fail / reject), `expect` (what\n   the author predicted), `reason` (free-text explanation shown on\n   failure), `abort` (stop the outer loop after this sample?),\n   `error` (the raised exception when `status = Failed`).\n - Driver-option overrides: the `maybe_*` fields let a combinator\n   reconfigure the run from *inside* the property (e.g.\n   `with_max_success(50)`); `State::update_state_from_res`\n   copies any `Some` back onto `State`.\n - Metadata attached by combinators: `labels` / `classes` /\n   `tables` feed the coverage report, `test_case` collects\n   counter-example lines, and `callbacks` carries the `PostTest`\n   / `PostFinalFailure` hooks to run later.","attrs":[]}
{"key":"moonbitlang/quickcheck.forall_shrink","pkg":"moonbitlang/quickcheck","name":"forall_shrink","parent":"moonbitlang/quickcheck","kind":["value_alias","function","moonbitlang/quickcheck/property.forall_shrink"],"sig_":"pub fn[T : @property.Testable, A : @debug.Debug] forall_shrink(@gen.Gen[A], (A) -> Iter[A], (A) -> T) -> @property.Property","doc":"Run a property with an explicit generator and shrinker.","attrs":[]}
{"key":"moonbitlang/core/debug.Debug_for_moonbitlang/quickcheck/modifiers.Positive","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/debug.Debug_for_moonbitlang/quickcheck/modifiers.Positive","parent":null,"kind":["impl","moonbitlang/core/debug.Debug","moonbitlang/quickcheck/modifiers.Positive"],"sig_":"pub impl[T : @debug.Debug] @debug.Debug for Positive[T]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.Positive.not_equal:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"not_equal","parent":"moonbitlang/quickcheck/modifiers.Positive","kind":"method","sig_":"pub fn[T : Eq] Positive::not_equal(Self[T], Self[T]) -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.expected:Field","pkg":"moonbitlang/quickcheck/internal/state","name":"expected","parent":"moonbitlang/quickcheck/internal/state.State","kind":"field","sig_":"mut expected : Expected","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/laws.Equivalence.to_repr:Method","pkg":"moonbitlang/quickcheck/laws","name":"to_repr","parent":"moonbitlang/quickcheck/laws.Equivalence","kind":"method","sig_":"pub fn[T : @debug.Debug] Equivalence::to_repr(Self[T]) -> @debug.Repr","doc":null,"attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/quickcheck/laws.Equivalence.rhs:Field","pkg":"moonbitlang/quickcheck/laws","name":"rhs","parent":"moonbitlang/quickcheck/laws.Equivalence","kind":"field","sig_":"rhs : T","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/property.Property.run:Method","pkg":"moonbitlang/quickcheck/property","name":"run","parent":"moonbitlang/quickcheck/property.Property","kind":"method","sig_":"pub fn Property::run(Self, Int, @splitmix.RandomState) -> @rose.Rose[@state.SingleResult]","doc":"Evaluate a `Property` with an explicit size and random state.\n This is the controlled representation boundary used by drivers.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.ArrowError.property:Method","pkg":"moonbitlang/quickcheck/property","name":"property","parent":"moonbitlang/quickcheck/property.ArrowError","kind":"method","sig_":"pub fn[P : Testable, A : @quickcheck.Arbitrary + @shrink.Shrink + @debug.Debug] ArrowError::property(Self[A, P]) -> Property","doc":"`Testable` for a raising function: wraps `raise` as a failure by\n catching the error and turning it into the counter-example reason.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.fold_left:Method","pkg":"moonbitlang/quickcheck/internal/lazy","name":"fold_left","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"method","sig_":"pub fn[T, U] LazyList::fold_left(Self[T], (U, T) -> U, init~ : U) -> U","doc":"Left fold. **Forces the entire list** before returning — not safe\n on infinite input.\n\n ```mbt check\n test {\n   let xs : LazyList[Int] = from_list(@list.from_array([1, 2, 3, 4]))\n   assert_eq(xs.fold_left((acc, x) => acc + x, init=0), 10)\n }\n ```","attrs":[]}
