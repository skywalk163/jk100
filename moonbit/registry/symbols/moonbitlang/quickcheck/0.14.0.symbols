{"key":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/tuple.Tuple5","pkg":"moonbitlang/quickcheck/shrink","name":"moonbitlang/quickcheck/shrink.Shrink_for_moonbitlang/core/tuple.Tuple5","parent":null,"kind":["impl","moonbitlang/quickcheck/shrink.Shrink","moonbitlang/core/tuple.Tuple5"],"sig_":"pub impl[A : Shrink, B : Shrink, C : Shrink, D : Shrink, E : Shrink] Shrink for (A, B, C, D, E)","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.Cons","pkg":"moonbitlang/quickcheck/internal/lazy","name":"Cons","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"variant","sig_":"Cons(T, LazyRef[LazyList[T]])","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.Kind","pkg":"moonbitlang/quickcheck/internal/state","name":"Kind","parent":"moonbitlang/quickcheck/internal/state","kind":"type","sig_":"enum Kind","doc":"Which lifecycle stage a `Callback` wants to fire at. Used by the\n driver to decide whether a callback's role is to decorate the\n counter-example (`CounterExample`) or to stay quiet\n (`Nothing`) — the dispatch happens inside\n `State::callback_post_test` / `State::callback_post_final_failure`.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.Coverage.to_array:Method","pkg":"moonbitlang/quickcheck/internal/state","name":"to_array","parent":"moonbitlang/quickcheck/internal/state.Coverage","kind":"method","sig_":"pub fn Coverage::to_array(Self, Int) -> Array[String]","doc":"Render the labels + classes tally as percentage lines for the\n report (normalised against `success`, the number of passing\n samples). Called by `CheckReport::render` in the root package.","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.Gen.Gen:Method","pkg":"moonbitlang/quickcheck/gen","name":"Gen","parent":"moonbitlang/quickcheck/gen.Gen","kind":["value_alias","method","moonbitlang/quickcheck/gen.Gen.Gen:Method"],"sig_":"pub fn[T] Gen::Gen((Int, @splitmix.RandomState) -> T) -> Self[T]","doc":"Build a `Gen[T]` from a `(size, rng) -> T` function. In most cases\n you can use the primary constructor syntax `Gen(f)` instead — both\n produce an identical generator.","attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.NonEmptyArray.shrink:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"shrink","parent":"moonbitlang/quickcheck/modifiers.NonEmptyArray","kind":"method","sig_":"pub fn[T : @shrink.Shrink] NonEmptyArray::shrink(Self[T]) -> Iter[Self[T]]","doc":null,"attrs":[]}
