{"key":"moonbitlang/quickcheck/internal/lazy.LazyList.fold_right:Method","pkg":"moonbitlang/quickcheck/internal/lazy","name":"fold_right","parent":"moonbitlang/quickcheck/internal/lazy.LazyList","kind":"method","sig_":"pub fn[T, U] LazyList::fold_right(Self[T], (T, U) -> U, init~ : U) -> U","doc":"Right fold. Naive / strict in the accumulator, so also not safe on\n infinite input without extra care.","attrs":[]}
