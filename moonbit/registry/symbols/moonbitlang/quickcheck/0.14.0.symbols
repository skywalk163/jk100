{"key":"moonbitlang/quickcheck/internal/lazy.zip_lazy_normal","pkg":"moonbitlang/quickcheck/internal/lazy","name":"zip_lazy_normal","parent":"moonbitlang/quickcheck/internal/lazy","kind":"function","sig_":"pub fn[A, B, C] zip_lazy_normal((A, B) -> C, LazyList[A], @list.List[B]) -> @list.List[C]","doc":"Zip a `LazyList` with an eager `@list.List`, producing an eager\n `@list.List`. Stops when either runs out. Used internally by\n `feat`'s convolution: the enumeration's parts live in a\n `LazyList`, the finite sides live in eager lists.","attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.Small.not_equal:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"not_equal","parent":"moonbitlang/quickcheck/modifiers.Small","kind":"method","sig_":"pub fn[T : Eq] Small::not_equal(Self[T], Self[T]) -> Bool","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/laws.Axiom.run:Method","pkg":"moonbitlang/quickcheck/laws","name":"run","parent":"moonbitlang/quickcheck/laws.Axiom","kind":"method","sig_":"pub fn[T] Axiom::run(Self[T], T) -> Equivalence[T]","doc":"Evaluate an axiom at `x` and return the pair of values whose\n equality the axiom asserts.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.sum","pkg":"moonbitlang/quickcheck/internal/lazy","name":"sum","parent":"moonbitlang/quickcheck/internal/lazy","kind":"function","sig_":"pub fn[X : Add] sum(LazyList[X], init~ : X) -> X","doc":"Sum via `Add::add`, seeded with `init`. Forces the whole list.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.zip_with","pkg":"moonbitlang/quickcheck/internal/lazy","name":"zip_with","parent":"moonbitlang/quickcheck/internal/lazy","kind":"function","sig_":"pub fn[A, B, C] zip_with((A, B) -> C, LazyList[A], LazyList[B]) -> LazyList[C]","doc":"Element-wise combine. Stops when either input ends — the shorter\n list wins and the rest of the longer one is ignored.\n\n ```mbt check\n test {\n   let xs : LazyList[Int] = from_list(@list.from_array([1, 2, 3]))\n   let ys : LazyList[Int] = from_list(@list.from_array([10, 20]))\n   let zs = zip_with((a, b) => a + b, xs, ys)\n   @debug.assert_eq(zs.iter().collect(), [11, 22])\n }\n ```","attrs":[]}
