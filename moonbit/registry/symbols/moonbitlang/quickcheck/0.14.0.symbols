{"key":"moonbitlang/quickcheck/laws.distributive_left","pkg":"moonbitlang/quickcheck/laws","name":"distributive_left","parent":"moonbitlang/quickcheck/laws","kind":"function","sig_":"pub fn[A : Eq] distributive_left((A, A) -> A, (A, A) -> A) -> ((A, A, A)) -> Bool","doc":"Distributive binary operation over the left.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.Testable_for_moonbitlang/quickcheck/property.ArrowError","pkg":"moonbitlang/quickcheck/property","name":"moonbitlang/quickcheck/property.Testable_for_moonbitlang/quickcheck/property.ArrowError","parent":null,"kind":["impl","moonbitlang/quickcheck/property.Testable","moonbitlang/quickcheck/property.ArrowError"],"sig_":"pub impl[P : Testable, A : @quickcheck.Arbitrary + @shrink.Shrink + @debug.Debug] Testable for ArrowError[A, P]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck.Expected","pkg":"moonbitlang/quickcheck","name":"Expected","parent":"moonbitlang/quickcheck","kind":["type_alias","moonbitlang/quickcheck/internal/state.Expected"],"sig_":"pub using @state {type Expected}","doc":"Re-export `Expected` from `internal/state` so the public driver\n API (`quick_check(..., expect=Fail)`) stays spelled as\n `@quickcheck.Expected` even though the enum now lives in the\n internal package alongside the rest of the driver state.","attrs":[]}
{"key":"moonbitlang/quickcheck/laws.Equivalence","pkg":"moonbitlang/quickcheck/laws","name":"Equivalence","parent":"moonbitlang/quickcheck/laws","kind":"type","sig_":"struct Equivalence[T]","doc":"A pair of values whose equality under some relation we are trying\n to establish. `Equivalence` is the data type behind the axiom\n helpers in this package.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.Config.max_success:Field","pkg":"moonbitlang/quickcheck/internal/state","name":"max_success","parent":"moonbitlang/quickcheck/internal/state.Config","kind":"field","sig_":"max_success : Int","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/utils.fresh_name","pkg":"moonbitlang/quickcheck/internal/utils","name":"fresh_name","parent":"moonbitlang/quickcheck/internal/utils","kind":"function","sig_":"pub fn fresh_name() -> String","doc":"Generate a process-global monotonically-unique string of the form\n `\"test-0\"`, `\"test-1\"`, `\"test-2\"`, … Useful when a test needs *some*\n unique label and the specific value does not matter (e.g. when\n creating disposable temp directories or sentinel identifiers).\n\n The counter is shared across all callers in the same process, so\n concurrent tests observe interleaved names and the numeric suffix\n is *not* a stable handle — don't pattern-match on it.","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.backtrack","pkg":"moonbitlang/quickcheck/gen","name":"backtrack","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T] backtrack(Array[(UInt, Gen[T?])]) -> Gen[T?]","doc":"Tries weighted optional generators without replacement until one succeeds.","attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.NonEmptyList","pkg":"moonbitlang/quickcheck/modifiers","name":"NonEmptyList","parent":"moonbitlang/quickcheck/modifiers","kind":"type","sig_":"struct NonEmptyList[T](@list.List[T])","doc":"Wraps a `List[T]` guaranteed to be non-empty. Shrinks without\n producing the empty list.","attrs":[]}
{"key":"moonbitlang/quickcheck/shrink.shrink_non_empty_list","pkg":"moonbitlang/quickcheck/shrink","name":"shrink_non_empty_list","parent":"moonbitlang/quickcheck/shrink","kind":"function","sig_":"pub fn[T : Shrink] shrink_non_empty_list(@list.List[T]) -> Iter[@list.List[T]]","doc":"Shrink non-empty list without producing the empty list.\n\n ```mbt check\n test {\n   let xs : @list.List[Int] = @list.from_array([5])\n   // Default list shrink would produce [], which is filtered out here.\n   assert_true(shrink_non_empty_list(xs).all(ys => !ys.is_empty()))\n }\n ```","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/report.TestSuccess","pkg":"moonbitlang/quickcheck/internal/report","name":"TestSuccess","parent":"moonbitlang/quickcheck/internal/report","kind":"type","sig_":"enum TestSuccess","doc":"Successful test outcomes — either the property passed\n `max_success` times, or it gave up but the user `expect`ed that.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.counts:Method","pkg":"moonbitlang/quickcheck/internal/state","name":"counts","parent":"moonbitlang/quickcheck/internal/state.State","kind":"method","sig_":"pub fn State::counts(Self) -> String","doc":"Render the `[ok/discarded/total]` triple that prefixes every\n report line.","attrs":[]}
{"key":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.NonZero","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.NonZero","parent":null,"kind":["impl","moonbitlang/core/builtin.Eq","moonbitlang/quickcheck/modifiers.NonZero"],"sig_":"pub impl[T : Eq] Eq for NonZero[T]","doc":null,"attrs":[]}
