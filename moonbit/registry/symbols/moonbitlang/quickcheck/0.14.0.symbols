{"key":"moonbitlang/quickcheck/modifiers.UnicodeString","pkg":"moonbitlang/quickcheck/modifiers","name":"UnicodeString","parent":"moonbitlang/quickcheck/modifiers","kind":"type","sig_":"struct UnicodeString(String)","doc":"Wraps a `String` whose characters are Unicode scalar values. The generated\n string never contains UTF-16 surrogate codepoints.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.callback_post_final_failure:Method","pkg":"moonbitlang/quickcheck/internal/state","name":"callback_post_final_failure","parent":"moonbitlang/quickcheck/internal/state.State","kind":"method","sig_":"pub fn State::callback_post_final_failure(Self, SingleResult) -> Unit","doc":"Fire every `PostFinalFailure` callback attached to `res`. Called\n exactly once at the end of the shrink search, so combinators like\n `counterexample` can pull in extra context only for the minimal\n failing input.","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.tuple","pkg":"moonbitlang/quickcheck/gen","name":"tuple","parent":"moonbitlang/quickcheck/gen","kind":"function","sig_":"pub fn[T, U] tuple(Gen[T], Gen[U]) -> Gen[(T, U)]","doc":"Create tuple generator from two generators\n\n ```mbt check\n test {\n   let g : Gen[(Int, String)] = tuple(pure(7), pure(\"x\"))\n   @debug.assert_eq(g.sample(), (7, \"x\"))\n }\n ```","attrs":[]}
