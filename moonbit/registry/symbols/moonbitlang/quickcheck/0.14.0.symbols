{"key":"moonbitlang/quickcheck/feat.Finite.to_repr:Method","pkg":"moonbitlang/quickcheck/feat","name":"to_repr","parent":"moonbitlang/quickcheck/feat.Finite","kind":"method","sig_":"pub fn[T : @debug.Debug] Finite::to_repr(Self[T]) -> @debug.Repr","doc":"`Debug` renders the full element list (via `to_array`). Don't call\n on a very large chunk — it forces everything.","attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/quickcheck/modifiers.Positive.to_repr:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"to_repr","parent":"moonbitlang/quickcheck/modifiers.Positive","kind":"method","sig_":"pub fn[T : @debug.Debug] Positive::to_repr(Self[T]) -> @debug.Repr","doc":null,"attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/quickcheck/internal/lazy.from_list","pkg":"moonbitlang/quickcheck/internal/lazy","name":"from_list","parent":"moonbitlang/quickcheck/internal/lazy","kind":"function","sig_":"pub fn[T] from_list(@list.List[T]) -> LazyList[T]","doc":"Promote an eager `@list.List[T]` to a `LazyList[T]` whose tails are\n already computed. Same semantics as `to_lazy`, provided as a\n top-level function for symmetry.","attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.SortedList.shrink:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"shrink","parent":"moonbitlang/quickcheck/modifiers.SortedList","kind":"method","sig_":"pub fn SortedList::shrink(Self[Int]) -> Iter[Self[Int]]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/feat.Enumerate.op_get:Method","pkg":"moonbitlang/quickcheck/feat","name":"op_get","parent":"moonbitlang/quickcheck/feat.Enumerate","kind":["attribute_value_alias","method","moonbitlang/quickcheck/feat.Enumerate.at:Method"],"sig_":"pub fn[T] Enumerate::op_get(Self[T], @bigint.BigInt) -> T","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/feat.unary","pkg":"moonbitlang/quickcheck/feat","name":"unary","parent":"moonbitlang/quickcheck/feat","kind":"function","sig_":"pub fn[T : Enumerable, U] unary((T) -> U) -> Enumerate[U]","doc":"Apply a unary constructor: `unary(f) == T::enumerate().fmap(f)`.\n For multi-argument constructors, write a tuple lambda so `f` takes\n a single tuple argument — e.g. `unary(p => Node(p.0, p.1))` — then\n `unary(f)` goes through the built-in pair `Enumerable` instance\n which inserts the required `pay`.","attrs":[]}
{"key":"moonbitlang/quickcheck/laws.Equivalence.is_equal:Method","pkg":"moonbitlang/quickcheck/laws","name":"is_equal","parent":"moonbitlang/quickcheck/laws.Equivalence","kind":"method","sig_":"pub fn[T : Eq] Equivalence::is_equal(Self[T]) -> Bool","doc":"Evaluate the equivalence under structural equality (`Eq`). Returns\n `true` iff `lhs == rhs`. Shortcut for `equal_by(Eq::equal)`.","attrs":[]}
{"key":"moonbitlang/quickcheck/property.Discard.default:Method","pkg":"moonbitlang/quickcheck/property","name":"default","parent":"moonbitlang/quickcheck/property.Discard","kind":"method","sig_":"pub fn Discard::default() -> Self","doc":"automatically derived","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.State.name:Field","pkg":"moonbitlang/quickcheck/internal/state","name":"name","parent":"moonbitlang/quickcheck/internal/state.State","kind":"field","sig_":"name : String","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/state.Callback.PostFinalFailure","pkg":"moonbitlang/quickcheck/internal/state","name":"PostFinalFailure","parent":"moonbitlang/quickcheck/internal/state.Callback","kind":"variant","sig_":"PostFinalFailure(Kind, (State, SingleResult) -> Unit)","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/utils.apply_while_array","pkg":"moonbitlang/quickcheck/internal/utils","name":"apply_while_array","parent":"moonbitlang/quickcheck/internal/utils","kind":"function","sig_":"pub fn[T] apply_while_array(T, (T) -> T, (T) -> Bool) -> Array[T]","doc":"Array-shaped counterpart of `apply_while_list`. Same reverse-order\n accumulation: newest-kept value first, oldest last.\n\n ```mbt check\n test {\n   @debug.assert_eq(apply_while_array(16, z => z / 2, z => z > 0), [1, 2, 4, 8])\n }\n ```","attrs":[]}
{"key":"moonbitlang/core/debug.Debug_for_moonbitlang/quickcheck/modifiers.NonNegative","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/debug.Debug_for_moonbitlang/quickcheck/modifiers.NonNegative","parent":null,"kind":["impl","moonbitlang/core/debug.Debug","moonbitlang/quickcheck/modifiers.NonNegative"],"sig_":"pub impl[T : @debug.Debug] @debug.Debug for NonNegative[T]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/internal/rose.Rose.iter:Method","pkg":"moonbitlang/quickcheck/internal/rose","name":"iter","parent":"moonbitlang/quickcheck/internal/rose.Rose","kind":"method","sig_":"pub fn[T] Rose::iter(Self[T]) -> Iter[T]","doc":"Pre-order traversal: yields the root value, then the values of every\n branch depth-first. Enables `for x in rose { ... }` and any other\n `Iter`-shaped consumer.\n\n The traversal is lazy: only as many sub-trees as you actually walk\n are forced. Note that — like every `Iter` in MoonBit — the result\n is single-shot; iterating the same `Rose` twice will only visit the\n elements that were not yet consumed by an earlier walk.","attrs":[]}
{"key":"moonbitlang/quickcheck/gen.Gen.run:Method","pkg":"moonbitlang/quickcheck/gen","name":"run","parent":"moonbitlang/quickcheck/gen.Gen","kind":"method","sig_":"pub fn[T] Gen::run(Self[T], Int, @splitmix.RandomState) -> T","doc":"Run a generator with a size and random state","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/benchmark","pkg":"moonbitlang/quickcheck/internal/benchmark","name":"moonbitlang/quickcheck/internal/benchmark","parent":null,"kind":"package","sig_":null,"doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.NonEmptyList.to_repr:Method","pkg":"moonbitlang/quickcheck/modifiers","name":"to_repr","parent":"moonbitlang/quickcheck/modifiers.NonEmptyList","kind":"method","sig_":"pub fn[T : @debug.Debug] NonEmptyList::to_repr(Self[T]) -> @debug.Repr","doc":null,"attrs":[["as_free_fn",null,false]]}
{"key":"moonbitlang/quickcheck/laws.pure_eq","pkg":"moonbitlang/quickcheck/laws","name":"pure_eq","parent":"moonbitlang/quickcheck/laws","kind":"function","sig_":"pub fn[T] pure_eq(T) -> Equivalence[T]","doc":"Unit of the `Equivalence` applicative: both sides are the same\n value `x`. Trivially equal under any relation.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/lazy.zip_plus","pkg":"moonbitlang/quickcheck/internal/lazy","name":"zip_plus","parent":"moonbitlang/quickcheck/internal/lazy","kind":"function","sig_":"pub fn[T] zip_plus((T, T) -> T, LazyList[T], LazyList[T]) -> LazyList[T]","doc":"Element-wise combine that **keeps the longer tail** instead of\n truncating at the shorter input. Exactly the shape needed to fuse\n the size-indexed parts of two `Enumerate`s in `feat` — if one\n enumeration runs out of parts, the other's remaining parts pass\n through unchanged.\n\n ```mbt check\n test {\n   let xs : LazyList[Int] = from_list(@list.from_array([1, 2]))\n   let ys : LazyList[Int] = from_list(@list.from_array([10, 20, 30, 40]))\n   @debug.assert_eq(zip_plus((a, b) => a + b, xs, ys).iter().collect(), [\n     11, 22, 30, 40,\n   ])\n }\n ```","attrs":[]}
{"key":"moonbitlang/core/quickcheck.Arbitrary_for_moonbitlang/quickcheck/modifiers.NonEmptyList","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/quickcheck.Arbitrary_for_moonbitlang/quickcheck/modifiers.NonEmptyList","parent":null,"kind":["impl","moonbitlang/core/quickcheck.Arbitrary","moonbitlang/quickcheck/modifiers.NonEmptyList"],"sig_":"pub impl[T : @quickcheck.Arbitrary] @quickcheck.Arbitrary for NonEmptyList[T]","doc":null,"attrs":[]}
