{"key":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.SortedList","pkg":"moonbitlang/quickcheck/modifiers","name":"moonbitlang/core/builtin.Eq_for_moonbitlang/quickcheck/modifiers.SortedList","parent":null,"kind":["impl","moonbitlang/core/builtin.Eq","moonbitlang/quickcheck/modifiers.SortedList"],"sig_":"pub impl[T : Eq] Eq for SortedList[T]","doc":null,"attrs":[]}
{"key":"moonbitlang/quickcheck/modifiers.NonEmptyArray","pkg":"moonbitlang/quickcheck/modifiers","name":"NonEmptyArray","parent":"moonbitlang/quickcheck/modifiers","kind":"type","sig_":"struct NonEmptyArray[T](Array[T])","doc":"Wraps an `Array[T]` guaranteed to be non-empty. Shrinks without\n producing the empty array.","attrs":[]}
{"key":"moonbitlang/quickcheck/laws.inverse","pkg":"moonbitlang/quickcheck/laws","name":"inverse","parent":"moonbitlang/quickcheck/laws","kind":"function","sig_":"pub fn[A : Eq, B] inverse((A) -> B, (B) -> A) -> (A) -> Bool","doc":"Inverse function.","attrs":[]}
{"key":"moonbitlang/quickcheck/feat.consts","pkg":"moonbitlang/quickcheck/feat","name":"consts","parent":"moonbitlang/quickcheck/feat","kind":"function","sig_":"pub fn[T] consts(@list.List[Enumerate[T]]) -> Enumerate[T]","doc":"`pay`-wrapped union of a list of sub-enumerations. Typical use:\n write one `Enumerate` per constructor of a sum type, then combine\n with `consts`. The outer `pay` charges one size unit for the\n constructor tag.","attrs":[]}
