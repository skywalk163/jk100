{"key":"moonbitlang/quickcheck/property.Discard","pkg":"moonbitlang/quickcheck/property","name":"Discard","parent":"moonbitlang/quickcheck/property","kind":"type","sig_":"type Discard","doc":"A property that discards the current test case.","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/rose.Rose.join:Method","pkg":"moonbitlang/quickcheck/internal/rose","name":"join","parent":"moonbitlang/quickcheck/internal/rose.Rose","kind":"method","sig_":"pub fn[T] Rose::join(Self[Self[T]]) -> Self[T]","doc":"Flatten `Rose[Rose[T]]` into `Rose[T]` — the monadic `join`.\n\n The inner tree at the root contributes its value and its branches;\n the outer tree's branches are recursively joined and prepended to\n the inner branches. Used internally to implement `bind`.\n\n ```mbt check\n test {\n   let nested : Rose[Rose[Int]] = pure(pure(42))\n   @debug.assert_eq(nested.join().iter().collect(), [42])\n }\n ```","attrs":[]}
