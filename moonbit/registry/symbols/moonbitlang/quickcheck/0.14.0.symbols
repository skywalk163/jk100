{"key":"moonbitlang/quickcheck/internal/rose.Rose.bind:Method","pkg":"moonbitlang/quickcheck/internal/rose","name":"bind","parent":"moonbitlang/quickcheck/internal/rose.Rose","kind":"method","sig_":"pub fn[T, U] Rose::bind(Self[T], (T) -> Self[U]) -> Self[U]","doc":"Monadic bind: replace each node's value with the tree produced by\n `f`. Equivalent to `self.fmap(f).join()`.\n\n ```mbt check\n test {\n   let r = pure(3).bind(x => pure(x * x))\n   @debug.assert_eq(r.iter().collect(), [9])\n }\n ```","attrs":[]}
{"key":"moonbitlang/quickcheck/internal/testing.Queue","pkg":"moonbitlang/quickcheck/internal/testing","name":"Queue","parent":"moonbitlang/quickcheck/internal/testing","kind":"type","sig_":"type Queue","doc":null,"attrs":[]}
